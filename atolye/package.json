{
  "name": "atolye",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atölye: an interactive, in-browser reader for the 30 Days of Python course",
  "scripts": {
    "prepare-course": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "markdown-it": "15.0.3",
    "ogl": "1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
